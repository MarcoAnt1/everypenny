# Copy this file to `.env` and fill in real values.

# Secret used to sign JWT auth tokens. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# PostgreSQL connection string.
# Matches the Docker command in the README.
DATABASE_URL=postgresql://everypenny:everypenny@localhost:5432/everypenny?schema=public

# Required to register a new user (the app is invite-gated).
# Whoever registers must send this exact value as `inviteToken`.
INVITE_TOKEN=dev-invite-token

# Port the API listens on (optional, defaults to 3000).
PORT=3000
