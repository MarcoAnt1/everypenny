generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  checking
  savings
  credit_card
  cash
  investment
}

enum TxType {
  income
  expense
  transfer
}

enum TxStatus {
  cleared
  pending
  reconciled
}

enum TxDirection {
  in
  out
}

enum BudgetPeriod {
  monthly
  quarterly
  yearly
}

enum GoalStatus {
  active
  completed
  cancelled
}

enum ShareRole {
  EDITOR
  VIEWER
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedAccounts       Account[]      @relation("AccountOwner")
  accountShares       AccountShare[]
  sentConnections     Connection[]   @relation("RequesterConnections")
  receivedConnections Connection[]   @relation("InviteeConnections")
  categories          Category[]
  budgets             Budget[]
  goals               Goal[]
  tags                Tag[]
}

model Account {
  id          String      @id @default(uuid())
  ownerId     String
  name        String
  type        AccountType
  institution String?
  // TODO: consider migrating to derived balance if balance drift becomes a recurring
  // support issue. Would remove Account.balance and compute from SUM(Transaction.amount).
  balance     Decimal     @default(0) @db.Decimal(19, 4)
  currency    String      @default("CAD") @db.Char(3)
  creditLimit Decimal?    @db.Decimal(19, 4)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  owner             User           @relation("AccountOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  accountShares     AccountShare[]
  transactions      Transaction[]  @relation("FromAccount")
  incomingTransfers Transaction[]  @relation("ToAccount")

  @@unique([ownerId, name])
}

model AccountShare {
  accountId String
  userId    String
  role      ShareRole @default(EDITOR)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([accountId, userId])
  @@index([userId])
}

model Connection {
  id                 String           @id @default(uuid())
  requesterId        String
  inviteeId          String?
  inviteeEmail       String
  status             ConnectionStatus @default(PENDING)
  shareAllAccounts   Boolean          @default(false)
  shareAllBudgets    Boolean          @default(false)
  shareAllCategories Boolean          @default(false)
  shareAllGoals      Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  requester User  @relation("RequesterConnections", fields: [requesterId], references: [id], onDelete: Cascade)
  invitee   User? @relation("InviteeConnections", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, inviteeEmail])
  @@index([inviteeId])
  @@index([inviteeEmail])
  @@index([status])
}

// TODO(future): soft delete via `deletedAt DateTime?` + trash view UI. Not worth the
// query-site churn until users actually complain about accidental deletes.
model Transaction {
  id              String       @id @default(uuid())
  accountId       String
  categoryId      String?
  toAccountId     String?
  transferGroupId String?
  // TODO(balance-rework): Drop `direction` and make `amount` signed
  // (positive = entered accountId, negative = left accountId). Coordinate
  // with the balanceChange rewrite in transactions.ts.
  direction       TxDirection?
  description     String
  amount          Decimal      @db.Decimal(19, 4)
  date            DateTime
  type            TxType
  status          TxStatus     @default(cleared)
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  account   Account          @relation("FromAccount", fields: [accountId], references: [id], onDelete: Cascade)
  toAccount Account?         @relation("ToAccount", fields: [toAccountId], references: [id], onDelete: SetNull)
  category  Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags      TransactionTag[]

  @@index([accountId, date(sort: Desc)])
  @@index([categoryId])
  @@index([toAccountId])
  @@index([date])
  @@index([transferGroupId])
}

model Category {
  id        String   @id @default(uuid())
  userId    String?
  parentId  String?
  name      String
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent        Category?     @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  subcategories Category[]    @relation("CategoryToCategory")
  transactions  Transaction[]
  budgets       Budget[]

  @@unique([userId, parentId, name])
  @@index([userId])
  @@index([parentId])
}

model Budget {
  id          String       @id @default(uuid())
  userId      String
  categoryId  String
  name        String
  limitAmount Decimal      @db.Decimal(19, 4)
  period      BudgetPeriod
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, period])
  @@index([userId])
  @@index([categoryId])
}

model Goal {
  id            String     @id @default(uuid())
  userId        String
  name          String
  description   String?
  targetAmount  Decimal    @db.Decimal(19, 4)
  currentAmount Decimal    @default(0) @db.Decimal(19, 4)
  targetDate    DateTime?
  status        GoalStatus @default(active)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Tag {
  id        String   @id @default(uuid())
  userId    String
  name      String
  color     String? // Hex color code
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions TransactionTag[]

  @@unique([userId, name])
  @@index([userId])
}

model TransactionTag {
  transactionId String
  tagId         String
  createdAt      DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId]) // Composite primary key
}
